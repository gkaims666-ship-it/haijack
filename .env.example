# Local Claude Code — настройки.
# Где искать: переменные окружения > ./.env в проекте > ~/.lcc/.env

# --- Доступ к API (нужно одно из двух) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=         # Bearer-токен для прокси/корпоративного шлюза

# Кастомный эндпоинт, совместимый с Anthropic Messages API (прокси, шлюз)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Модели ---
# LCC_MODEL=claude-sonnet-5-5
# Отдельные модели для агентов (например, дешёвая для Executor):
# LCC_MODEL_ARCHITECT=claude-opus-5-5
# LCC_MODEL_CODER=claude-sonnet-5-5
# LCC_MODEL_REVIEWER=claude-sonnet-5-5
# LCC_MODEL_EXECUTOR=claude-haiku-5-5
# LCC_MODEL_SOLO=claude-sonnet-5-5

# --- Качество ---
# Качество кода определяет прежде всего модель. Для максимума поставьте самую сильную
# доступную вашему ключу модель архитектору, кодеру и ревьюеру.
# LCC_THINKING=adaptive         # рассуждения модели: adaptive (по умолчанию) | off | число (бюджет токенов для старых моделей)
# LCC_EFFORT=high               # глубина проработки: low | medium | high (пусто = по умолчанию у модели)
# LCC_PROMPT_CACHE=1            # кэширование промта: дешевле и быстрее на длинных задачах (0 = выключить)

# --- Локальные модели (Ollama, LM Studio, llama.cpp) ---
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_MODEL=                # основная модель (с поддержкой вызова инструментов)
# LOCAL_LLM_FAST_MODEL=           # быстрая модель для Executor
# LOCAL_LLM_FALLBACK_MODEL=       # запасная: на неё клиент переходит при сбое основной
# LOCAL_LLM_NUM_CTX=32768         # размер контекста (параметр Ollama)
# LOCAL_LLM_TIMEOUT=180000        # мс без данных от модели, после которых запрос считается сбойным

# --- Выполнение задач ---
# LCC_MAX_CYCLES=5                # заходов на задачу, пока ревью и проверки не пройдут (0 = без ограничения)
# LCC_MEMORY=1                    # долговременная память между задачами (0 = выключить)

# --- Поведение ---
# LCC_MAX_TOKENS=16000          # лимит ответа модели за один вызов
# LCC_MAX_TURNS=60              # шагов с инструментами на одного агента
# LCC_MAX_FIX_ROUNDS=3          # сколько раз Coder может исправлять по замечаниям Reviewer и Executor
# LCC_CMD_TIMEOUT=120           # таймаут команды, сек
# LCC_AUTO_APPROVE=0            # 1 = не спрашивать подтверждение записи/команд (опасные — всегда спрашиваются)
# LCC_ALLOW_OUTSIDE=0           # 1 = разрешить запись вне папки проекта
# LCC_SHELL=                    # Windows: pwsh | powershell | cmd ; POSIX: bash | sh
# LCC_ASCII=0                   # 1 = только ASCII-символы (старый conhost)
# LCC_IGNORE=tmp,logs           # доп. папки, которые не обходить при поиске
# NO_COLOR=1                    # отключить цвета

# --- Веб-интерфейс (lcc --web) ---
# LCC_WEB_PORT=0                # 0 = любой свободный порт
