<?xml version="1.0" encoding="utf-8"?>
<!--
  Незашифрованный HTTP нужен для собственного сервера программы на этом устройстве (127.0.0.1),
  для сервера моделей и сессии на компьютере в локальной сети. Адреса локальной сети заранее
  неизвестны, поэтому разрешение общее. Запросы к API Anthropic идут по HTTPS из встроенного Node.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
